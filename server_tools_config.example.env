# Optional Phase 2 server tools settings for Render
SERVER_TIMEZONE=Asia/Tehran
AUTOMATION_DELIVERY_MODE=both
PUBLIC_BASE_URL=https://YOUR-SERVICE.onrender.com
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
FILE_SIGNING_SECRET=PASTE_A_RANDOM_SECRET_HERE

# JSON storage paths (ephemeral on Render without a persistent disk)
AUTOMATION_FILE=server_automation.json
SERVER_FILES_DIR=server_files
